{
  "uid": "finledger-overview",
  "title": "FinLedger Engine — Overview",
  "tags": ["finledger", "ledger", "engineering"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP latency p95 / p99 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"finledger-engine\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"finledger-engine\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx error rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"finledger-engine\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Checkout throughput (TPS)",
      "description": "Timer @Timed(\"ledger.checkout\") pada LedgerServiceImpl",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ledger_checkout_seconds_count{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "checkout/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Settlement batch (created vs paid per s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finledger_settlement_created_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(rate(finledger_settlement_paid_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "paid"
        },
        {
          "refId": "C",
          "expr": "sum(rate(finledger_settlement_rejected_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Settlement payout value per s (IDR)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyIDR", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finledger_settlement_payout_amount_sum{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "payout/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Reconciliation runs & discrepancies",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finledger_reconciliation_runs_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "runs/s"
        },
        {
          "refId": "B",
          "expr": "max(finledger_reconciliation_discrepancies_max{application=\"finledger-engine\"})",
          "legendFormat": "max temuan"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Payment proof uploads per s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finledger_payment_proof_uploaded_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "uploaded/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(finledger_payment_proof_rejected_total{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "rejected/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"finledger-engine\",area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=\"finledger-engine\",area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HikariCP connections (active / idle / pending)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"finledger-engine\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{application=\"finledger-engine\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{application=\"finledger-engine\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP requests by status class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"finledger-engine\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Temuan rekonsiliasi terakhir (0 = BALANCED)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(finledger_reconciliation_discrepancies_max{application=\"finledger-engine\"})",
          "legendFormat": "temuan"
        }
      ]
    }
  ]
}
